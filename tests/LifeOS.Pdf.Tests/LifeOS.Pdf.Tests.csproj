<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LifeOsTestTargets)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LifeOS.Pdf\LifeOS.Pdf.csproj" />
    <ProjectReference Include="..\..\src\LifeOS.Pdf.Signing\LifeOS.Pdf.Signing.csproj" />
    <ProjectReference Include="..\..\src\LifeOS.Pdf.Barcode.Scanning\LifeOS.Pdf.Barcode.Scanning.csproj" />
    <ProjectReference Include="..\..\src\LifeOS.Pdf.Rendering\LifeOS.Pdf.Rendering.csproj" />
    <ProjectReference Include="..\..\src\LifeOS.Pdf.Ocr\LifeOS.Pdf.Ocr.csproj" />
    <ProjectReference Include="..\..\src\LifeOS.Pdf.Scanning\LifeOS.Pdf.Scanning.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Tests call internal APIs, some of which use nullable reference conventions loosely. -->
    <NoWarn>$(NoWarn);xUnit1026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="TestAssets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The sample data of the built-in templates doubles as test data. -->
    <None Include="..\..\samples\LifeOS.Pdf.Samples\Assets\data\*.json" Link="TestAssets\data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
