<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- One sample app per supported runtime proves the package works on each. -->
    <TargetFrameworks>net5.0;net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(LifeOsSdkHasNet10)' == 'true'">$(TargetFrameworks);net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LifeOS.Pdf\LifeOS.Pdf.csproj" />
  </ItemGroup>

  <!-- HTML → PDF (Fase 11) needs .NET 8+; older runtimes build the rest of the showcase without it. -->
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <ProjectReference Include="..\..\src\LifeOS.Pdf.Html\LifeOS.Pdf.Html.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
