<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LifeOsLibraryTargets)</TargetFrameworks>
    <RootNamespace>LifeOS.Pdf.Barcode.Scanning</RootNamespace>
    <PackageId>LifeOS.Pdf.Barcode.Scanning</PackageId>
    <Description>Read QR codes and barcodes (zxing-cpp) from images and PDF documents.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LifeOS.Pdf\LifeOS.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZXingCpp" Version="0.5.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
