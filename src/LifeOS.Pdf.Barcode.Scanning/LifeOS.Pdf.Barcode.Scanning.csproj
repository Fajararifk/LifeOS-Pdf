<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LifeOsLibraryTargets)</TargetFrameworks>
    <RootNamespace>LifeOS.Pdf.Barcode.Scanning</RootNamespace>
    <PackageId>LifeOS.Pdf.Barcode.Scanning</PackageId>
    <Description>Read QR codes and barcodes (ZXing.Net) from images and PDF documents.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LifeOS.Pdf\LifeOS.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZXingCpp" Version="0.5.3" />
  </ItemGroup>

</Project>
