<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Everything needs .NET 8 (LifeOS.Pdf.Signing targets net8.0). -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LifeOS.Pdf.All</RootNamespace>
    <PackageId>LifeOS.Pdf.All</PackageId>
    <Description>Everything in one command: LifeOS.Pdf plus signing, rendering, barcode scanning, OCR, the combined scanner and HTML → PDF (.NET 8+).</Description>
    <!-- A meta-package: it contains no code, only dependencies on the other packages. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageType>Dependency</PackageType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- NU5128: the dependency group has no matching lib/ref folder, which is the point. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LifeOS.Pdf\LifeOS.Pdf.csproj" />
    <ProjectReference Include="..\LifeOS.Pdf.Signing\LifeOS.Pdf.Signing.csproj" />
    <ProjectReference Include="..\LifeOS.Pdf.Rendering\LifeOS.Pdf.Rendering.csproj" />
    <ProjectReference Include="..\LifeOS.Pdf.Barcode.Scanning\LifeOS.Pdf.Barcode.Scanning.csproj" />
    <ProjectReference Include="..\LifeOS.Pdf.Ocr\LifeOS.Pdf.Ocr.csproj" />
    <ProjectReference Include="..\LifeOS.Pdf.Scanning\LifeOS.Pdf.Scanning.csproj" />
    <ProjectReference Include="..\LifeOS.Pdf.Html\LifeOS.Pdf.Html.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
