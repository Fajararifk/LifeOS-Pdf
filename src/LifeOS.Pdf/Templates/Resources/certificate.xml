<?xml version="1.0" encoding="utf-8"?>
<!--
  LifeOS.Pdf built-in template: certificate (sertifikat), A4 landscape.
  Data: Number, Title (default "SERTIFIKAT"), Subtitle, RecipientName, Role, Event, Description,
        Date, City, Organization{Name, Logo},
        Signers[{Name, Title, Signature (image, optional)}] (1–3).
-->
<document title="{{ Title | default:'Sertifikat' }} — {{ RecipientName }}" author="{{ Organization.Name }}">
  <styles>
    <normal family="times" size="12" color="#1F2937"/>
  </styles>
  <section size="A4" orientation="landscape" margin="14mm">
    <table border="#0F766E 3" grid="none" headerBackground="none" padding="6" spaceBefore="0" spaceAfter="0">
      <column width="*"/>
      <row>
        <cell>
          <table border="#99F6E4 0.75" grid="none" headerBackground="none" padding="26 22" spaceBefore="0" spaceAfter="0">
            <column width="*"/>
            <!-- Fills the A4 landscape page inside the 14 mm margins with a few points to spare. -->
            <row minHeight="484">
              <cell align="center">
                <image if="Organization.Logo" src="{{ Organization.Logo }}" width="70" align="center" spaceBefore="0" spaceAfter="8"/>
                <p family="helvetica" size="10" bold="true" color="#0F766E" spaceAfter="14">{{ Organization.Name | upper }}</p>
                <p size="38" bold="true" color="#0F766E" spaceAfter="2">{{ Title | default:"SERTIFIKAT" }}</p>
                <p family="helvetica" size="10" color="#6B7280" spaceAfter="22">{{ Subtitle | default:"PENGHARGAAN" | upper }} · No. {{ Number }}</p>
                <p size="13" italic="true" spaceAfter="6">Diberikan kepada</p>
                <p size="30" bold="true" spaceAfter="4">{{ RecipientName }}</p>
                <hr color="#0F766E" thickness="0.75" spaceBefore="0" spaceAfter="12"/>
                <p size="13" spaceAfter="4">atas partisipasinya sebagai <b>{{ Role }}</b> dalam</p>
                <p size="16" bold="true" color="#0F766E" spaceAfter="6">{{ Event }}</p>
                <p if="Description" size="11" color="#4B5563" spaceAfter="18">{{ Description }}</p>
                <p size="11" spaceAfter="16">{{ City }}<if test="City">, </if>{{ Date | date:"d MMMM yyyy" }}</p>

                <table border="none" grid="none" headerBackground="none" padding="0 12" spaceBefore="0" spaceAfter="0">
                  <foreach in="Signers" as="s"><column width="*" align="center"/></foreach>
                  <row>
                    <foreach in="Signers" as="s">
                      <cell valign="bottom">
                        <image if="s.Signature" src="{{ s.Signature }}" width="100" align="center" spaceBefore="0" spaceAfter="0"/>
                        <spacer if="!s.Signature" height="44"/>
                        <p size="12" bold="true" underline="true" spaceAfter="1">{{ s.Name }}</p>
                        <p family="helvetica" size="9" color="#6B7280" spaceAfter="0">{{ s.Title }}</p>
                      </cell>
                    </foreach>
                  </row>
                </table>
              </cell>
            </row>
          </table>
        </cell>
      </row>
    </table>
  </section>
</document>
